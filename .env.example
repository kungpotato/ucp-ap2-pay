# Read by backend/ (Go). Copy to .env at the repo root.
# OPENROUTER_API_KEY here is unused directly by the backend — the frontend
# reads its own copy from frontend/.env.local — this key is kept here too
# only as the canonical source you copy from.

# Optional: enables LLM tool-calling for the shopping agent (lesson 3).
# Without it, /agent falls back to a deterministic rule-based parser
# automatically — no functionality is lost outside natural-language understanding.
OPENROUTER_API_KEY=

# --- lesson 6: on-chain settlement (Foundry, mainnet fork) -----------------

# RPC URL for `anvil --fork-url ...`. Not read by the Go backend directly —
# documented here so it lives next to the other chain config. See
# contracts/README.md for the full fork + fund + deploy walkthrough.
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# Where the Go backend's JSON-RPC client points. Defaults to this value if
# unset — only override if you run anvil on a different host/port.
ANVIL_RPC_URL=http://127.0.0.1:8545

# The wallet that should receive settled USDC. Passed to
# `forge script script/Deploy.s.sol` as MERCHANT_WALLET_ADDRESS too, so both
# sides agree on who "the merchant" is.
MERCHANT_WALLET_ADDRESS=

# Printed by `forge script script/Deploy.s.sol --broadcast` after you deploy
# Settlement.sol. Without it, /x402/orders/{id}/pay can quote a price but
# can never verify a payment (no contract address to match tx logs against).
SETTLEMENT_CONTRACT_ADDRESS=
